# Maintainer: anuzdhk <anuzsystem@gmail.com>
# "teku" on the AUR is the ConsenSys Ethereum client.
pkgname=teku-installer
pkgver=0.1.2
pkgrel=1
pkgdesc='Install apps from a right-click: .deb, .rpm, AppImage and .flatpakref'
arch=('any')
url='https://github.com/anuzdhk/teku'
license=('MIT')
depends=('bash' 'zenity' 'polkit' 'file')
conflicts=('teku')
optdepends=('python-nautilus: top-level "Install with Teku" in GNOME Files'
            'flatpak: install .flatpakref files')
source=("teku-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "teku-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
